VITE_API_URL=http://127.0.0.1:3000/api/v1
# Public configuration only. Never put JWT_SECRET or database credentials here.
# Local Vite HTTP workflow only; use 127.0.0.1 for both frontend and API.
# Render single-origin build requires VITE_API_URL=/api/v1 in platform bindings.
# Deployment refuses local .env files; Vite values are public build-time values.
