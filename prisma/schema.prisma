generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "esm"
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  ADMIN
  CLIENT
  MASTER

  @@map("user_role")
}

enum OrderStatus {
  OPEN
  PENDING
  ACCEPTED
  IN_PROGRESS
  COMPLETED
  CANCELLED
  DECLINED

  @@map("order_status")
}

enum OrderType {
  STANDARD
  CUSTOM

  @@map("order_type")
}

enum Category {
  TECH_REPAIR
  PLUMBING
  ELECTRICAL
  OTHER

  @@map("category")
}

model User {
  id            String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email         String         @unique @db.VarChar(254)
  passwordHash  String         @map("password_hash") @db.VarChar(255)
  name          String         @db.VarChar(100)
  role          UserRole
  createdAt     DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  masterProfile MasterProfile?
  orders        Order[]        @relation("ClientOrders")

  @@map("users")
}

model MasterProfile {
  id          String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId      String          @unique @map("user_id") @db.Uuid
  city        String          @db.VarChar(100)
  description String?         @db.Text
  category    Category        @default(OTHER)
  isApproved  Boolean         @default(false) @map("is_approved")
  user        User            @relation(fields: [userId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  services    Service[]
  orders      Order[]
  responses   OrderResponse[]

  @@map("master_profiles")
}

model Service {
  id              String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  masterProfileId String        @map("master_profile_id") @db.Uuid
  title           String        @db.VarChar(160)
  category        Category
  description     String        @db.Text
  price           Decimal       @db.Decimal(10, 2)
  isActive        Boolean       @default(true) @map("is_active")
  masterProfile   MasterProfile @relation(fields: [masterProfileId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  orders          Order[]

  @@unique([id, masterProfileId])
  @@index([masterProfileId])
  @@index([category, isActive])
  @@map("services")
}

model Order {
  id              String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  clientId        String          @map("client_id") @db.Uuid
  type            OrderType       @default(STANDARD)
  serviceId       String?         @map("service_id") @db.Uuid
  masterProfileId String?         @map("master_profile_id") @db.Uuid
  title           String          @db.VarChar(160)
  city            String          @db.VarChar(100)
  category        Category
  description     String          @db.Text
  priceAtOrder    Decimal?        @map("price_at_order") @db.Decimal(10, 2)
  status          OrderStatus     @default(PENDING)
  createdAt       DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime        @default(now()) @map("updated_at") @db.Timestamptz(3)
  statusHistory   Json            @default("[]") @map("status_history") @db.JsonB
  client          User            @relation("ClientOrders", fields: [clientId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  service         Service?        @relation(fields: [serviceId, masterProfileId], references: [id, masterProfileId], onDelete: Restrict, onUpdate: Restrict)
  masterProfile   MasterProfile?  @relation(fields: [masterProfileId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  responses       OrderResponse[]

  @@index([clientId, createdAt])
  @@index([serviceId])
  @@index([masterProfileId])
  @@index([status, createdAt])
  @@index([type, status, city, category])
  @@map("orders")
}

model OrderResponse {
  id              String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orderId         String        @map("order_id") @db.Uuid
  masterProfileId String        @map("master_profile_id") @db.Uuid
  proposedPrice   Decimal       @map("proposed_price") @db.Decimal(10, 2)
  message         String        @db.Text
  createdAt       DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  order           Order         @relation(fields: [orderId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  masterProfile   MasterProfile @relation(fields: [masterProfileId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@unique([orderId, masterProfileId])
  @@index([masterProfileId])
  @@map("order_responses")
}
