Project FixIT {
  database_type: 'PostgreSQL'
  Note: 'Hybrid MVP 1.0: five business tables plus technical auth_sessions. Prices are exact UAH decimal(10,2). SQL triggers enforce initial states, transitions, immutable snapshots, history and offer eligibility. User ADMIN/is_approved are retained internal legacy compatibility, not public features.'
}
Enum user_role {
  ADMIN
  CLIENT
  MASTER
}
Enum order_type {
  STANDARD
  CUSTOM
}
Enum order_status {
  OPEN
  PENDING
  ACCEPTED
  IN_PROGRESS
  COMPLETED
  CANCELLED
  DECLINED
}
Enum service_category {
  TECH_REPAIR
  PLUMBING
  ELECTRICAL
  OTHER
}
Table users {
  id uuid [pk, not null, default: `gen_random_uuid()`]
  email varchar(254) [not null]
  password_hash varchar(255) [not null, note: 'Hash only; unchanged contract for PR #2']
  name varchar(100) [not null]
  role user_role [not null, note: 'ADMIN retained internally; never publicly registered']
  created_at timestamptz(3) [not null, default: `now()`]
  indexes { email [unique, name: 'users_email_key'] }
  checks { `email = lower(btrim(email))` [name: 'users_email_canonical_check'] }
}
Table master_profiles {
  id uuid [pk, not null, default: `gen_random_uuid()`]
  user_id uuid [not null, note: 'Role MASTER required by existing SQL trigger']
  city varchar(100) [not null]
  description text [null, note: 'Renamed bio; legacy NULL values preserved']
  category service_category [not null, default: 'OTHER']
  is_approved boolean [not null, default: false, note: 'Internal legacy compatibility; no approval UI added']
  indexes { user_id [unique, name: 'master_profiles_user_id_key'] }
  checks { `btrim(city) <> ''` [name: 'master_profiles_city_check'] }
}
Table services {
  id uuid [pk, not null, default: `gen_random_uuid()`]
  master_profile_id uuid [not null]
  title varchar(160) [not null]
  category service_category [not null]
  description text [null]
  price_estimate decimal(10,2) [null, note: 'UAH, old integer cents divided exactly by 100']
  is_active boolean [not null, default: true]
  indexes {
    (id, master_profile_id) [unique, name: 'services_id_master_profile_id_key']
    master_profile_id [name: 'services_master_profile_id_idx']
    (category, is_active) [name: 'services_category_is_active_idx']
  }
  checks {
    `price_estimate >= 0 AND price_estimate <= 99999999.99` [name: 'services_price_estimate_check']
    `btrim(title) <> ''` [name: 'services_title_check']
  }
}
Table orders {
  id uuid [pk, not null, default: `gen_random_uuid()`]
  client_id uuid [not null, note: 'CLIENT required by existing SQL trigger']
  type order_type [not null, default: 'STANDARD']
  service_id uuid [null, note: 'Required STANDARD; always NULL CUSTOM']
  master_profile_id uuid [null, note: 'Required STANDARD; CUSTOM assigned once from an existing response']
  title varchar(160) [not null, note: 'Content snapshot: immutable after INSERT by SQL trigger']
  city varchar(100) [not null, note: 'Immutable content snapshot']
  category service_category [not null, note: 'Immutable content snapshot']
  description text [not null, note: 'Immutable content snapshot']
  price_at_order decimal(10,2) [null, note: 'Immutable optional snapshot: STANDARD price estimate; CUSTOM selected offer estimate; NULL means unknown']
  budget decimal(10,2) [null, note: 'Optional CUSTOM budget, immutable after creation; STANDARD NULL']
  status order_status [not null, default: 'PENDING', note: 'CUSTOM must explicitly start OPEN; enforced by SQL trigger/server']
  created_at timestamptz(3) [not null, default: `now()`]
  updated_at timestamptz(3) [not null, default: `now()`, note: 'Maintained by SQL trigger']
  status_history jsonb [not null, default: `'[]'::jsonb`, note: 'Append-only DB-managed status/at/actorUserId/source events; one observed legacy migration event']
  indexes {
    (client_id, created_at) [name: 'orders_client_id_created_at_idx']
    service_id [name: 'orders_service_id_idx']
    master_profile_id [name: 'orders_master_profile_id_idx']
    (status, created_at) [name: 'orders_status_created_at_idx']
    (type, status, city, category) [name: 'orders_type_status_city_category_idx']
  }
  checks {
    `budget >= 0 AND budget <= 99999999.99` [name: 'orders_budget_check']
    `price_at_order >= 0 AND price_at_order <= 99999999.99` [name: 'orders_price_at_order_check']
    `btrim(title) <> '' AND btrim(city) <> '' AND btrim(description) <> ''` [name: 'orders_text_check']
    `jsonb_typeof(status_history) = 'array' AND jsonb_array_length(status_history) > 0` [name: 'orders_history_check']
    `(type = 'STANDARD' AND service_id IS NOT NULL AND master_profile_id IS NOT NULL AND budget IS NULL AND status <> 'OPEN') OR (type = 'CUSTOM' AND service_id IS NULL AND ((status IN ('OPEN','CANCELLED') AND master_profile_id IS NULL AND price_at_order IS NULL) OR (status IN ('ACCEPTED','IN_PROGRESS','COMPLETED','CANCELLED') AND master_profile_id IS NOT NULL)))` [name: 'orders_shape_check']
  }
}
Table order_responses {
  id uuid [pk, not null, default: `gen_random_uuid()`]
  order_id uuid [not null, note: 'Only OPEN unassigned CUSTOM can receive proposals']
  master_profile_id uuid [not null]
  proposed_price decimal(10,2) [null, note: 'Optional estimate; a text-only response is valid']
  message text [not null]
  created_at timestamptz(3) [not null, default: `now()`]
  indexes {
    (order_id, master_profile_id) [unique, name: 'order_responses_order_id_master_profile_id_key']
    master_profile_id [name: 'order_responses_master_profile_id_idx']
  }
  checks {
    `proposed_price >= 0 AND proposed_price <= 99999999.99` [name: 'order_responses_proposed_price_check']
    `btrim(message) <> ''` [name: 'order_responses_message_check']
  }
}
Ref master_profiles_user_id_fkey: users.id - master_profiles.user_id [delete: restrict, update: cascade]
Ref services_master_profile_id_fkey: services.master_profile_id > master_profiles.id [delete: restrict, update: cascade]
Ref orders_client_id_fkey: orders.client_id > users.id [delete: restrict, update: cascade]
Ref orders_service_id_master_profile_id_fkey: orders.(service_id, master_profile_id) > services.(id, master_profile_id) [delete: restrict, update: restrict]
Ref orders_master_profile_id_fkey: orders.master_profile_id > master_profiles.id [delete: restrict, update: restrict]
Ref order_responses_order_id_fkey: order_responses.order_id > orders.id [delete: restrict, update: restrict]
Ref order_responses_master_profile_id_fkey: order_responses.master_profile_id > master_profiles.id [delete: restrict, update: restrict]

Table auth_sessions {
  id uuid [pk, not null, default: `gen_random_uuid()`]
  user_id uuid [not null]
  token_hash character(64) [not null, unique, note: 'SHA-256 of high-entropy opaque token; never plaintext']
  previous_token_hash character(64)
  generation integer [not null, default: 0]
  created_at timestamptz(3) [not null, default: `now()`]
  last_used_at timestamptz(3) [not null, default: `now()`]
  expires_at timestamptz(3) [not null, note: 'Absolute 7-day deadline; never extended']
  rotated_at timestamptz(3)
  revoked_at timestamptz(3)
  revoked_reason varchar(16)
  indexes {
    (user_id, revoked_at) [name: 'auth_sessions_user_id_revoked_at_idx']
    expires_at [name: 'auth_sessions_expires_at_idx']
  }
  checks {
    `token_hash ~ '^[0-9a-f]{64}$' AND (previous_token_hash IS NULL OR previous_token_hash ~ '^[0-9a-f]{64}$')` [name: 'auth_sessions_hash_check']
    `generation >= 0 AND ((generation = 0 AND previous_token_hash IS NULL AND rotated_at IS NULL) OR (generation > 0 AND previous_token_hash IS NOT NULL AND rotated_at IS NOT NULL))` [name: 'auth_sessions_generation_check']
    `expires_at > created_at AND last_used_at >= created_at AND last_used_at < expires_at AND (rotated_at IS NULL OR (rotated_at >= created_at AND rotated_at = last_used_at)) AND (revoked_at IS NULL OR revoked_at >= created_at)` [name: 'auth_sessions_time_check']
    `(revoked_at IS NULL AND revoked_reason IS NULL) OR (revoked_at IS NOT NULL AND revoked_reason IS NOT NULL AND revoked_reason IN ('logout','replay','expired'))` [name: 'auth_sessions_revocation_check']
  }
  Note: 'Technical auth state only. SQL CHECK enforces hashes, generation/previous-hash pairing, timestamps and revocation state. Refresh idle limit 24h; 2s duplicate window returns no credentials.'
}
Ref auth_sessions_user_id_fkey: auth_sessions.user_id > users.id [delete: cascade, update: cascade]
