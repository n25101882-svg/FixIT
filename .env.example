# EXAMPLE ONLY. Copy to .env and set your own local PostgreSQL test-role password.
# Never use production credentials. Never commit .env.
DATABASE_URL="postgresql://fixit_test:CHANGE_ME@127.0.0.1:5432/fixit_test?schema=public"
TEST_DATABASE_URL="postgresql://fixit_test:CHANGE_ME@127.0.0.1:5432/fixit_test?schema=public"
SHADOW_DATABASE_URL="postgresql://fixit_test:CHANGE_ME@127.0.0.1:5432/fixit_shadow?schema=public"
HOST=127.0.0.1
PORT=3000
JWT_SECRET=""
# Generate a local secret: node -e "console.log(require('node:crypto').randomBytes(48).toString('hex'))"
# Keep the generated value only in .env or secure environment settings.
JWT_TTL_SECONDS=900
CORS_ORIGINS="http://127.0.0.1:5173,http://localhost:5173"
# Codex Cloud: source /workspace/.fixit-dev/env.sh instead; its test port is 55432.
