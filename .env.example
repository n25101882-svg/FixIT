# EXAMPLE ONLY. Copy to .env and set your own local PostgreSQL test-role password.
# Never use production credentials. Never commit .env.
DATABASE_URL="postgresql://fixit_test:CHANGE_ME@127.0.0.1:5432/fixit_orders_test?schema=public"
TEST_DATABASE_URL="postgresql://fixit_test:CHANGE_ME@127.0.0.1:5432/fixit_orders_test?schema=public"
# Optional only for migrate dev, using a separately authorised shadow DB.
# Release/deploy uses migrate deploy and must not touch existing fixit_shadow.
SHADOW_DATABASE_URL=""
HOST=127.0.0.1
PORT=3000
NODE_ENV=development
# 0 for local/direct traffic; Render uses exactly one trusted ingress (1).
TRUST_PROXY_HOPS=0
JWT_SECRET=""
# Generate a local secret: node -e "console.log(require('node:crypto').randomBytes(48).toString('hex'))"
# Keep the generated value only in .env or secure environment settings.
JWT_TTL_SECONDS=900
CORS_ORIGINS="http://127.0.0.1:5173,http://localhost:5173"
# Three existing Hybrid migrations are applied with db:migrate; never reset/db push.
# Render uses its own secret bindings, HOST=0.0.0.0 and platform PORT.
# See docs/DEPLOYMENT_RENDER.md; never copy these local test URLs to Render.
# Every machine needs its own private TEST/DATABASE/SHADOW configuration.
# Optional: two DIFFERENT newly created empty local *_test databases for test:migrations.
# Fill only in your private environment; never point these at fixit_dev/production.
CLEAN_DATABASE_URL=""
UPGRADE_DATABASE_URL=""
