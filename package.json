{
  "name": "fixit",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "FixIT MVP backend and database foundation",
  "engines": {
    "node": ">=24.0.0 <25",
    "npm": ">=11 <12"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.tools.json",
    "start": "node dist/server.js",
    "db:generate": "prisma generate",
    "db:validate": "prisma validate",
    "db:migrate": "prisma migrate deploy",
    "db:migrate:dev": "prisma migrate dev",
    "db:status": "prisma migrate status",
    "db:seed": "prisma db seed",
    "db:check": "tsx scripts/check-database.ts",
    "er:validate": "node scripts/validate-dbml.mjs",
    "test": "npm run build && node --experimental-vm-modules node_modules/jest/bin/jest.js --runInBand",
    "frontend:dev": "npm run dev --workspace @fixit/frontend --",
    "frontend:build": "npm run build --workspace @fixit/frontend",
    "frontend:test": "npm run test --workspace @fixit/frontend",
    "test:e2e": "npm run build && playwright test --grep-invert \"@offers|@lifecycle|@catalog|@standard\" && playwright test --grep @offers && playwright test --grep @lifecycle && playwright test --grep @catalog && playwright test --grep @standard",
    "test:migrations": "npm run build && node scripts/verify-migrations.mjs",
    "frontend:coverage": "npm run coverage --workspace @fixit/frontend"
  },
  "dependencies": {
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "dotenv": "18.0.10",
    "express": "5.3.0",
    "pg": "8.23.1",
    "jsonwebtoken": "9.0.3",
    "cors": "2.8.6",
    "express-rate-limit": "8.7.4",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@dbml/core": "12.0.0",
    "@types/express": "5.0.6",
    "@types/node": "^24.10.0",
    "@types/pg": "8.23.1",
    "jest": "30.5.2",
    "prisma": "7.10.1",
    "supertest": "7.3.2",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "@types/jsonwebtoken": "9.0.10",
    "@types/cors": "2.8.19",
    "@playwright/test": "1.65.0"
  },
  "workspaces": [
    "frontend"
  ]
}
