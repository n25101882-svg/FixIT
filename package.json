{
  "name": "fixit",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "FixIT MVP backend and database foundation",
  "engines": {
    "node": ">=24.0.0 <25",
    "npm": ">=11 <12"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.tools.json",
    "start": "node dist/server.js",
    "db:generate": "prisma generate",
    "db:validate": "prisma validate",
    "db:migrate": "prisma migrate deploy",
    "db:migrate:dev": "prisma migrate dev",
    "db:status": "prisma migrate status",
    "db:seed": "prisma db seed",
    "db:check": "tsx scripts/check-database.ts",
    "er:validate": "node scripts/validate-dbml.mjs",
    "test": "npm run build && node --experimental-vm-modules node_modules/jest/bin/jest.js --runInBand",
    "test:migrations": "npm run build && node scripts/verify-migrations.mjs"
  },
  "dependencies": {
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "dotenv": "18.0.10",
    "express": "5.3.0",
    "pg": "8.23.1"
  },
  "devDependencies": {
    "@dbml/core": "12.0.0",
    "@types/express": "5.0.6",
    "@types/node": "^24.10.0",
    "@types/pg": "8.23.1",
    "jest": "30.5.2",
    "prisma": "7.10.1",
    "supertest": "7.3.2",
    "tsx": "4.23.15",
    "typescript": "5.9.3"
  }
}
